flowchart TD
    subgraph L1["第一层：Flutter 前端"]
        FLUTTER["聊天与任务界面：HTTP · SSE · 断线恢复"]
    end

    subgraph L2["第二层：Go 后端"]
        API["API：认证 · 收发消息 · SSE"]
        MESSAGES["消息服务：路由 · 保存消息 · 直接触发接收方"]
        DB[("PostgreSQL：agent 身份 · 消息历史 · Run 状态 · 执行轨迹")]

        subgraph MAINBOX["每用户固定一个 Main Agent"]
            MAIN["Main Runtime：messageList 上下文 · 按用户串行处理"]
            ASSIGN["assign_subagents"]
            SEND["send_message"]
            SEARCH["search_message"]
            READ["read_message"]

            MAIN <-->|"任务说明 / subagent_id"| ASSIGN
            MAIN <-->|"发送消息 / 投递回执"| SEND
            MAIN <-->|"搜索 / 消息 ID"| SEARCH
            MAIN <-->|"读取 / 完整内容"| READ
        end

        subgraph SUBBOX["Subagent：按任务创建"]
            SUB["Sub Runtime：独立上下文 · 后台执行 · 限额并行"]
            TOOLS["执行工具：搜索 · HTTP/MCP · 浏览器 · 代码"]

            SUB <-->|"工具调用 / 结果"| TOOLS
        end

        API <-->|"用户输入 / 对外消息与事件"| MESSAGES
        MESSAGES <-->|"保存与读取消息"| DB
        MESSAGES -->|"消息保存后直接触发 main"| MAIN
        MAIN <-->|"载入 messageList / 保存本轮轨迹"| DB

        ASSIGN <-->|"记录 Subagent 后异步启动 / 立即返回 subagent_id"| SUB
        SEND <-->|"投递给用户或指定 subagent / 回执"| MESSAGES
        SEARCH <-->|"按用户权限搜索历史"| DB
        READ <-->|"按 ID 和消息归属读取"| DB

        MESSAGES -->|"投递给 sub 的补充消息"| SUB
        SUB -.->|"进度 / 完成 / 失败回报，携带 subagent_id"| MESSAGES
        SUB <-->|"保存 Run 状态与执行轨迹"| DB
    end

    subgraph L3["第三层：外部服务 / 隔离的执行环境"]
        MODEL["模型供应商 API"]
        EXTERNAL["外部服务：搜索 · HTTP API · MCP"]
        SANDBOX["隔离执行环境：浏览器 · 代码"]
    end

    FLUTTER <-->|"HTTP 请求 / SSE 消息与任务事件"| API
    MAIN <-->|"模型推理 / 四个消息工具的调用请求"| MODEL
    SUB <-->|"模型推理 / 执行工具的调用请求"| MODEL
    TOOLS <-->|"外部服务调用 / 结果"| EXTERNAL
    TOOLS <-->|"隔离任务执行 / 结果"| SANDBOX
