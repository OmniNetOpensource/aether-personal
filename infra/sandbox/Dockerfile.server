FROM opensandbox/server:release-1.1.0@sha256:68ca0212a2749b2c73096ce2ec0264455c64442c45f81007db442f52bf84c9d1

# A running container remains valid after its original image tag is rebuilt.
# Report the image URI saved in its creation config without inspecting that image.
RUN python - <<'PY'
from pathlib import Path

source = Path("/app/opensandbox_server/services/docker/docker_service.py")
original = """        image_tags = container.image.tags
        image_uri = image_tags[0] if image_tags else container.image.short_id"""
replacement = """        image_uri = container.attrs.get("Config", {}).get("Image") or container.attrs.get("Image")"""
body = source.read_text()
if body.count(original) != 1:
    raise SystemExit("OpenSandbox image lookup changed; review the compatibility patch")
source.write_text(body.replace(original, replacement))
PY
