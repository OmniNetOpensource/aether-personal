# 本文件构建后端运行镜像，缓存迁移工具的编译层，并为普通用户准备可挂载持久卷的图片缓存目录。
FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
# 应用源码变化不需要重新编译迁移工具，也不需要携带其他数据库的驱动。
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
    -tags="no_clickhouse no_libsql no_mssql no_mysql no_sqlite3 no_vertica no_ydb" \
    -o /out/goose github.com/pressly/goose/v3/cmd/goose
COPY backend/cmd ./cmd
COPY backend/internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/import-services ./cmd/import-services

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -m 700 -o 10001 -g 10001 /var/cache/aether/images
WORKDIR /app
COPY --from=build /out/server /out/goose /out/import-services /usr/local/bin/
COPY backend/db/migrations ./db/migrations
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/server"]
