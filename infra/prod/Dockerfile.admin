# 本文件构建管理看板镜像：先用 TanStack Start 生成静态产物，再由独立 Node 服务托管并代理管理 API。
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
WORKDIR /app/admin
COPY admin/package.json admin/package-lock.json ./
RUN npm ci
COPY admin/ ./
RUN npm run build

FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
WORKDIR /app
COPY --chown=node:node admin/server.mjs ./
COPY --from=build --chown=node:node /app/admin/build/web ./build/web
ENV HOST=0.0.0.0 PORT=5174 API_UPSTREAM=http://api:8080
USER node
EXPOSE 5174
CMD ["node", "server.mjs"]
