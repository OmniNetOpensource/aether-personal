# 本文件构建管理看板镜像：先用 TanStack Start 生成静态产物，再由独立 Node 服务托管并代理管理 API。
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS build
WORKDIR /app/admin
RUN npm install -g pnpm@10.32.1
COPY admin/package.json admin/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY admin/ ./
RUN pnpm run build

FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370
WORKDIR /app
COPY --chown=node:node admin/server.mjs ./
COPY --from=build --chown=node:node /app/admin/build/web ./build/web
ENV HOST=0.0.0.0 PORT=5174 API_UPSTREAM=http://api-1:8080,http://api-2:8080
USER node
EXPOSE 5174
CMD ["node", "server.mjs"]
