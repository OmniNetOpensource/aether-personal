# 复制为本目录 .env，chmod 600。密码使用随机十六进制，避免连接串转义。
RELEASE_TAG=local
POSTGRES_PASSWORD=
ORIGIN_DOMAIN=origin-aether.forkicks.fun
ADMIN_DOMAIN=admin-aether.forkicks.fun
HTTP_PORT=80
HTTPS_PORT=443
# 与 Cloudflare Worker 的同名 Secret 相同，建议随机 32 字节十六进制。
ORIGIN_AUTH_SECRET=
# 用 openssl rand -base64 32 生成并备份。服务 Key、Gemini 地址、发件人由管理看板维护。
SERVICE_ENCRYPTION_KEY=
# 生产发验证码必须通过 Turnstile；缺少配置时只关闭发码，管理员仍可登录看板。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=aether.forkicks.fun
DATABASE_MAX_CONNS=20
# 留空默认 DATABASE_MAX_CONNS - 4，可调小以限制单进程并行用户数
AGENT_CAPACITY=
# 图片缓存使用独立持久卷，容量单位为字节，至少 4194304；有效期从写入开始计算，不随读取延长。
IMAGE_CACHE_MAX_BYTES=1073741824
IMAGE_CACHE_TTL=168h
MAIN_MODEL=
# 哈希用单引号包围，避免 Compose 展开其中的 $。留空关闭管理入口。
ADMIN_PASSWORD_HASH=

# FC 沙箱使用第二代、已安装存储客户端与 AIO 的自定义模板。API Key 在看板中保存。
# 每位用户先通过 init-workspace 绑定独立的 AgenticFS Access Point 与受限 RAM 角色。
SANDBOX_REGION=ap-southeast-1
SANDBOX_TEMPLATE=
SANDBOX_VPC_ID=
SANDBOX_SECURITY_GROUP_ID=
SANDBOX_VSWITCH_IDS=
# 空闲超过此时长由 FC 暂停；下一次工具调用恢复，实例被销毁后自动挂回原工作区。
SANDBOX_TIMEOUT=10m
