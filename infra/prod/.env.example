# 复制为本目录 .env，chmod 600。密码使用随机十六进制，避免连接串转义。
RELEASE_TAG=local
POSTGRES_PASSWORD=
ORIGIN_DOMAIN=origin-aether.forkicks.fun
ADMIN_DOMAIN=admin-aether.forkicks.fun
HTTP_PORT=80
HTTPS_PORT=443
# 与 Cloudflare Worker 的同名 Secret 相同，建议随机 32 字节十六进制。
ORIGIN_AUTH_SECRET=
# 用 openssl rand -base64 32 生成并备份。其他服务的 Key、Gemini 地址、发件人由管理看板维护。
SERVICE_ENCRYPTION_KEY=
# 生产发验证码必须通过 Turnstile；缺少配置时只关闭发码，管理员仍可登录看板。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=aether.forkicks.fun
DATABASE_MAX_CONNS=20
# 留空默认 DATABASE_MAX_CONNS - 4，限制每个后端容器的并行用户数；容器间通过内部纯内存 Redis 协调并共享图片缓存
AGENT_CAPACITY=
# Redis 共享图片缓存容量与绝对有效期（从写入开始计算，读取不续期）；容量单位为字节，默认 128 MiB，至少 4194304。
IMAGE_CACHE_MAX_BYTES=134217728
IMAGE_CACHE_TTL=24h
# App 模型请求和目录共用的 OpenRouter Key。
OPENROUTER_API_KEY=
# 哈希用单引号包围，避免 Compose 展开其中的 $。留空关闭管理入口。
ADMIN_PASSWORD_HASH=

# FC 沙箱使用第二代、已安装存储客户端与 AIO 的自定义模板。API Key 在看板中保存。
# 每位用户先通过 init-workspace 绑定独立的 AgenticFS Access Point 与受限 RAM 角色。
SANDBOX_REGION=ap-southeast-1
SANDBOX_TEMPLATE=
SANDBOX_VPC_ID=
SANDBOX_SECURITY_GROUP_ID=
SANDBOX_VSWITCH_IDS=
# 空闲超过此时长由 FC 暂停；下一次工具调用恢复，实例被销毁后自动挂回原工作区。
SANDBOX_TIMEOUT=10m
