# 复制为本目录 .env，chmod 600。密码使用随机十六进制，避免连接串转义。
RELEASE_TAG=local
POSTGRES_PASSWORD=
ORIGIN_DOMAIN=origin-aether.forkicks.fun
ADMIN_DOMAIN=admin-aether.forkicks.fun
HTTP_PORT=80
HTTPS_PORT=443
# 与 Cloudflare Worker 的同名 Secret 相同，建议随机 32 字节十六进制。
ORIGIN_AUTH_SECRET=
OPENROUTER_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=阿芒 <noreply@mail.forkicks.fun>
DATABASE_MAX_CONNS=20
MAIN_MODEL=
SUBAGENT_MODEL=
RECAP_MODEL=
MAX_OUTPUT_TOKENS=8192
SERP_API_KEY=
PARALLEL_API_KEY=
EVERYINFRA_API_KEY=
# 哈希用单引号包围，避免 Compose 展开其中的 $。留空关闭管理入口。
ADMIN_PASSWORD_HASH=
# 沙盒功能暂时关闭；以下历史配置不会启用工具。
# opensandbox 用于本地 Docker；aliyun 用于阿里云二代模板。
# SANDBOX_PROVIDER=opensandbox
# aliyun 示例：ap-southeast-1.e2b.fc.aliyuncs.com
# SANDBOX_DOMAIN=
# aliyun 示例：https://api.ap-southeast-1.e2b.fc.aliyuncs.com
# SANDBOX_URL=
# SANDBOX_API_KEY=
# opensandbox 填镜像；aliyun 填二代模板 ID。只影响新建环境。
# SANDBOX_IMAGE=
# SANDBOX_IDLE_SECONDS=300
