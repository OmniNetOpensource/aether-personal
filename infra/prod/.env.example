# 复制为本目录 .env，chmod 600。密码使用随机十六进制，避免连接串转义。
RELEASE_TAG=local
POSTGRES_PASSWORD=
ORIGIN_DOMAIN=origin-aether.forkicks.fun
ADMIN_DOMAIN=admin-aether.forkicks.fun
HTTP_PORT=80
HTTPS_PORT=443
# 与 Cloudflare Worker 的同名 Secret 相同，建议随机 32 字节十六进制。
ORIGIN_AUTH_SECRET=
# 用 openssl rand -base64 32 生成并备份。服务 Key、Gemini 地址、发件人由管理看板维护。
SERVICE_ENCRYPTION_KEY=
DATABASE_MAX_CONNS=20
MAIN_MODEL=
SUBAGENT_MODEL=
MAX_OUTPUT_TOKENS=8192
# 哈希用单引号包围，避免 Compose 展开其中的 $。留空关闭管理入口。
ADMIN_PASSWORD_HASH=
