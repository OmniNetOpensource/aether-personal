[
  {
    "description": "Execute a shell command. Sessions are managed automatically.",
    "inputSchema": {
      "properties": {
        "cmd": {
          "description": "Shell command to execute",
          "type": "string"
        },
        "cwd": {
          "description": "Absolute working directory. The response reports the directory the session ended in; pass it back on the next call to keep state in sync.",
          "type": "string"
        },
        "new_session": {
          "description": "Run in a fresh session instead of the shared default one",
          "type": "boolean"
        },
        "preserve_symlinks": {
          "description": "Accepted for 1.x compatibility and not acted on: this daemon starts each command in the directory as given",
          "type": "boolean"
        },
        "timeout": {
          "description": "Timeout in seconds (default 30)",
          "type": "integer"
        },
        "truncate": {
          "description": "Truncate large output (default true); false returns it whole",
          "type": "boolean"
        }
      },
      "required": [
        "cmd"
      ],
      "type": "object"
    },
    "name": "sandbox_execute_bash"
  },
  {
    "description": "Execute code in Python or JavaScript runtime.",
    "inputSchema": {
      "properties": {
        "code": {
          "description": "Code to execute",
          "type": "string"
        },
        "language": {
          "description": "Programming language ('python', 'javascript')",
          "type": "string"
        },
        "timeout": {
          "description": "Execution timeout in seconds",
          "type": "integer"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "name": "sandbox_execute_code"
  },
  {
    "description": "Unified file system operations tool for agents: read, write, replace, search, find, list, grep, glob.",
    "inputSchema": {
      "properties": {
        "action": {
          "description": "read | write | replace | search | find | list | grep | glob",
          "type": "string"
        },
        "append": {
          "description": "Append instead of overwriting on write",
          "type": "boolean"
        },
        "case_insensitive": {
          "description": "Case-insensitive grep",
          "type": "boolean"
        },
        "content": {
          "description": "Content for write, old_str for replace, or the regex for search",
          "type": "string"
        },
        "context_after": {
          "description": "Lines of trailing grep context",
          "type": "integer"
        },
        "context_before": {
          "description": "Lines of leading grep context",
          "type": "integer"
        },
        "encoding": {
          "description": "utf-8 | base64 | raw",
          "type": "string"
        },
        "end_line": {
          "description": "Line to stop before",
          "type": "integer"
        },
        "exclude": {
          "description": "Globs to skip for grep/glob",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_types": {
          "description": "Extension filter for list",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_only": {
          "description": "Return only files from glob",
          "type": "boolean"
        },
        "fixed_strings": {
          "description": "Treat the grep pattern as a literal",
          "type": "boolean"
        },
        "include": {
          "description": "File globs to search in for grep",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_metadata": {
          "description": "Include file metadata in glob",
          "type": "boolean"
        },
        "max_results": {
          "description": "Result cap for grep/glob",
          "type": "integer"
        },
        "path": {
          "description": "File or directory path",
          "type": "string"
        },
        "pattern": {
          "description": "Pattern for find/grep/glob (glob syntax or regex)",
          "type": "string"
        },
        "recursive": {
          "description": "Recurse for find/list/grep",
          "type": "boolean"
        },
        "show_hidden": {
          "description": "Include hidden entries",
          "type": "boolean"
        },
        "start_line": {
          "description": "First line to read (0-based)",
          "type": "integer"
        },
        "sudo": {
          "description": "Own created files as root",
          "type": "boolean"
        },
        "target": {
          "description": "new_str for replace",
          "type": "string"
        }
      },
      "required": [
        "action",
        "path"
      ],
      "type": "object"
    },
    "name": "sandbox_file_operations"
  },
  {
    "description": "File editor with the str_replace_editor grammar: view, create, str_replace, insert, undo_edit.",
    "inputSchema": {
      "properties": {
        "command": {
          "description": "view | create | str_replace | insert | undo_edit",
          "type": "string"
        },
        "file_text": {
          "description": "File content for create",
          "type": "string"
        },
        "insert_line": {
          "description": "Line number to insert at",
          "type": "integer"
        },
        "new_str": {
          "description": "Replacement string, or inserted text",
          "type": "string"
        },
        "old_str": {
          "description": "Original string to replace",
          "type": "string"
        },
        "path": {
          "description": "File path to operate on",
          "type": "string"
        },
        "replace_mode": {
          "description": "ALL | FIRST | LAST; omitted requires a unique match",
          "type": "string"
        },
        "view_range": {
          "description": "Line range for view, [start, end]",
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "command",
        "path"
      ],
      "type": "object"
    },
    "name": "sandbox_str_replace_editor"
  },
