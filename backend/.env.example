APP_ENV=dev
PORT=8080
POSTGRES_PORT=5432
DATABASE_URL=postgres://aether:aether@localhost:5432/aether
# 连接池上限，留空为 20，最小为 5；每个运行中的 Agent 占一条，普通请求预留 4 条
DATABASE_MAX_CONNS=
# 仅 prod 必填；dev 下验证码打印在后端日志中
RESEND_API_KEY=
EMAIL_FROM=
OPENROUTER_API_KEY=
# 留空则使用 deepseek/deepseek-v4.1-flash-1017
MAIN_MODEL=
# recap 独立模型；留空时跟随管理端当前 Main 模型。每 20 秒或 4 次请求触发。
RECAP_MODEL=
# 留空则使用 MAIN_MODEL 的实际值
SUBAGENT_MODEL=
# 沿用 Aether 的联网服务；未配置时相应工具返回错误，不能返回虚构结果
SERP_API_KEY=
PARALLEL_API_KEY=
EVERYINFRA_API_KEY=
# 同源提供 Lynx Web 构建产物；在 backend 下运行时使用此路径
FRONTEND_DIR=../frontend/build/web
# 配置后启用每用户独立持久 Linux 沙盒；镜像只影响新建环境
SANDBOX_URL=
SANDBOX_API_KEY=
SANDBOX_IMAGE=
SANDBOX_IDLE_SECONDS=300

# 管理看板密码哈希；留空时关闭管理入口。用 python3 scripts/set-admin-password.py 设置
ADMIN_PASSWORD_HASH=

# 单次请求的最大输出 Token（包含模型推理 Token），再按已知模型上限缩小
MAX_OUTPUT_TOKENS=8192
