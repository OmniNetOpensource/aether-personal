APP_ENV=dev
PORT=8080
POSTGRES_PORT=5432
DATABASE_URL=postgres://aether:aether@localhost:5432/aether
# 连接池上限，留空为 20，最小为 5；每个运行中的 Agent 占一条，普通请求预留 4 条
DATABASE_MAX_CONNS=
# 凭证加密主密钥，dev/prod 均必填；用 openssl rand -base64 32 生成，和数据库备份一起妥善保管。
# 六组服务 API Key、Gemini 地址和邮件发件人在管理看板的“服务配置”页保存。
SERVICE_ENCRYPTION_KEY=
# 留空则使用 deepseek/deepseek-v4.1-flash-1017；ikun Gemini 使用 ikun:gemini-... 模型 ID
MAIN_MODEL=
# 留空则使用 MAIN_MODEL 的实际值
SUBAGENT_MODEL=
# 同源提供 Web/PWA 构建产物；在 backend 下运行时使用此路径
FRONTEND_DIR=../frontend/build/web

# 管理看板密码哈希；留空时关闭管理入口。用 python3 scripts/set-admin-password.py 设置
ADMIN_PASSWORD_HASH=

# 单次请求的最大输出 Token（包含模型推理 Token），再按已知模型上限缩小
MAX_OUTPUT_TOKENS=8192
