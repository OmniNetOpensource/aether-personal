APP_ENV=dev
PORT=8080
POSTGRES_PORT=5432
DATABASE_URL=postgres://aether:aether@localhost:5432/aether
# 连接池上限，留空为 20，最小为 5；每个运行中的 Agent 占一条，普通请求预留 4 条
DATABASE_MAX_CONNS=
# 仅 prod 必填；dev 下验证码打印在后端日志中
RESEND_API_KEY=
EMAIL_FROM=
OPENROUTER_API_KEY=
# 留空则使用 minimax/minimax-m3.1-flash
MAIN_MODEL=
# 留空则使用 MAIN_MODEL 的实际值
SUBAGENT_MODEL=
# 沿用 Aether 的联网服务；未配置时相应工具返回错误，不能返回虚构结果
SERP_API_KEY=
PARALLEL_API_KEY=
EVERYINFRA_API_KEY=
# 同源提供 Flutter Web 构建产物；在 backend 下运行时使用此路径
FRONTEND_DIR=../frontend/build/web
