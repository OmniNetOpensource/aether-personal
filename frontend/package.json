{
  "name": "aether-personal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rsbuild build --config web.config.ts && npm run check && node scripts/build-pwa.mjs",
    "dev": "rsbuild dev --config web.config.ts",
    "design": "rsbuild dev --config design.config.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src scripts *.ts *.json public/manifest.webmanifest"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "0.16.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-virtuoso": "4.18.21",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-cjk-friendly": "1.2.3",
    "remark-cjk-friendly-gfm-strikethrough": "1.2.3",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rsbuild/core": "2.2.14",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/hast": "3.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.0"
  }
}
