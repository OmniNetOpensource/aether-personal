{
  "name": "aether-personal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run check && rsbuild build --config web.config.ts && node scripts/build-pwa.mjs",
    "dev": "rsbuild dev --config web.config.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src scripts *.ts *.json index.html public/manifest.webmanifest"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "entities": "^8.1.0",
    "marked": "17.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "2.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "@rsbuild/core": "2.2.14",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
